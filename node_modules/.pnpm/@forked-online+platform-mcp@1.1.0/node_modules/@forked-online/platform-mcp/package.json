{
  "name": "@forked-online/platform-mcp",
  "version": "1.1.0",
  "description": "MCP server for the Forked Online platform — let AI agents (Claude Code, etc.) read & write projects, work items, todos, activities, and memories in your workspace, and log Playwright visual verifications.",
  "type": "module",
  "bin": {
    "forked-online-platform-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp src/catalog.json dist/catalog.json",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "tsc && cp src/catalog.json dist/catalog.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://platform.forked.online/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrvigneshvt/forked-online-platform.git",
    "directory": "mcp"
  },
  "keywords": [ "mcp", "model-context-protocol", "forked-online", "platform", "ai-agent", "claude" ],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
